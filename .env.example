# ─────────────────────────────────────────────────────────────
# 3Sixty Protect — Environment variables
# Copy this file to `.env.local` and fill in real values.
# The public site renders with built-in demo data until these
# Supabase values are set, so you can develop the UI immediately.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server only, NEVER expose to the browser.
# Used for admin writes / bypassing RLS in server actions.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (optional, for when online payment is switched on)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Notification inbox for new enquiries/bookings (optional)
CONTACT_NOTIFICATION_EMAIL=
